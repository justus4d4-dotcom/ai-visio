# ──────────────────────────────────────────────────────────────────────────────
# Backend configuration. Copy to .env and fill in real values.
# ──────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection (psycopg3 driver)
DATABASE_URL=postgresql+psycopg://postgres:aiexams@localhost:5432/aiexams

# Shared secret with the Next.js frontend (Auth.js). MUST match AUTH_SECRET there.
# Used to verify the session JWT that the frontend sends to the backend.
AUTH_SECRET=change-me-to-a-long-random-string

# Fernet key used to encrypt per-user API keys at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-generate-a-fernet-key

# Comma-separated emails granted admin rights on first login (bootstrap admins).
BOOTSTRAP_ADMINS=you@example.com

# CORS: the frontend origin(s)
FRONTEND_ORIGINS=http://localhost:3000

# Auto-detection / OCR tuning
OCR_LANG=eng
# Hamming distance below which two frames are considered the "same" question.
FRAME_DIFF_THRESHOLD=8
