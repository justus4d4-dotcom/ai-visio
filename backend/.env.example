# ──────────────────────────────────────────────────────────────────────────────
# Backend configuration. Copy to .env and fill in real values.
# ──────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection (psycopg3 driver)
DATABASE_URL=postgresql+psycopg://postgres:aiexams@localhost:5432/aiexams

# Shared secret with the Next.js frontend (Auth.js). MUST match AUTH_SECRET there.
# Used to verify the session JWT that the frontend sends to the backend.
AUTH_SECRET=change-me-to-a-long-random-string

# Fernet key used to encrypt per-user API keys at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-generate-a-fernet-key

# Comma-separated emails granted admin rights on first login (bootstrap admins).
BOOTSTRAP_ADMINS=you@example.com

# CORS: the frontend origin(s)
FRONTEND_ORIGINS=http://localhost:3000

# ── Google sign-in (protects the public deployment) ───────────────────────────
# OAuth 2.0 "Web application" credentials. When BOTH are set, every /api route
# (except the auth handshake + health) requires a signed-in, allowed Google account.
# Register the redirect URI "<PUBLIC_BASE_URL>/api/auth/callback" in the Google console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public HTTPS origin the browser reaches (used to build the OAuth redirect URI).
PUBLIC_BASE_URL=https://visio.example.com
# Comma-separated allowlist of Google emails permitted in. Empty = allow any Google
# account that signs in (set this to lock the demo to just you).
ALLOWED_EMAILS=
# Shared secret so non-browser clients (native agent, ESP32) bypass the session check.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DEVICE_TOKEN=

# Auto-detection / OCR tuning
OCR_LANG=eng
# Hamming distance below which two frames are considered the "same" question.
FRAME_DIFF_THRESHOLD=8
